<?xml version="1.0"?>
<ruleset name="tickets-sharp">
    <description>PSR-12 coding standard for the Tickets Sharp plugin.</description>

    <file>src</file>
    <file>tests</file>
    <file>tickets-sharp.php</file>
    <file>uninstall.php</file>
    <file>build.php</file>

    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>

    <!-- PSR12 must stay the FIRST top-level rule: the README badge reads
         /ruleset/rule[1]/@ref, and CI asserts it. -->
    <rule ref="PSR12">
        <!-- Line endings are normalised by git (`* text=auto`): the index is LF, the
             Windows working copy is CRLF. This sniff only ever fires locally. -->
        <exclude name="Generic.Files.LineEndings"/>

        <!-- PSR-12's 120-character limit. The long lines here are HTML in rendered
             output and option/array literals, where wrapping costs more than it gives. -->
        <exclude name="Generic.Files.LineLength"/>

        <!-- Every source file carries the mandatory WordPress
             `if (!defined('ABSPATH')) { exit; }` guard, which PSR-1 counts as a side
             effect sitting alongside the class declaration. Not removable. -->
        <exclude name="PSR1.Files.SideEffects"/>
    </rule>

    <!-- Event Tickets calls these by name on its provider classes, so the
         subclass has to use its snake_case names: get_ticket, save_ticket,
         get_attendees_by_id, front_end_tickets_form and the rest. The same holds
         for the subclasses of its status manager and repositories. Renamed to
         camelCase they would simply never be called. -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>tests/*</exclude-pattern>
        <exclude-pattern>src/Commerce/Provider\.php</exclude-pattern>
        <exclude-pattern>src/Integration/*</exclude-pattern>
    </rule>

    <!-- Event Tickets' own property names ($attendee_object, $event_key...) are
         declared on its base class and must be set under those names. -->
    <rule ref="PSR2.Classes.PropertyDeclaration.Underscore">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!-- Test doubles, fakes and the Event Tickets / WooCommerce stubs are
         deliberately global, deliberately not PascalCase (Tribe__Tickets__Tickets,
         WC_Order), and deliberately grouped in the file that uses them. -->
    <rule ref="PSR1.Classes.ClassDeclaration">
        <exclude-pattern>tests/*</exclude-pattern>
        <!-- build.php is a standalone CLI build script, never autoloaded and never
             shipped; its PluginBuilder class is deliberately global. -->
        <exclude-pattern>build\.php</exclude-pattern>
    </rule>
    <rule ref="Squiz.Classes.ValidClassName">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="PSR12.Files.FileHeader">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>
